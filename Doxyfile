# Doxygen configuration of the Downloads organiser.
# Run from the repository root:  doxygen Doxyfile
# The HTML output goes to docs/doxygen/html (ignored by git).
PROJECT_NAME           = "Downloads organiser"
PROJECT_BRIEF          = "Sorts the files of a folder into sub-folders by file type"
OUTPUT_DIRECTORY       = docs/doxygen
INPUT                  = src
FILE_PATTERNS          = *.py
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
JAVADOC_AUTOBRIEF      = YES
PYTHON_DOCSTRING       = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
